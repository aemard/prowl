---
import dark from '../../../docs/screenshots/list-dark.png';
import light from '../../../docs/screenshots/list-light.png';
import Icon from '../components/Icon.astro';
import Screenshot from '../components/Screenshot.astro';
import Base from '../layouts/Base.astro';
import { INSTALL, page, REPO } from '../links';

const features = [
  {
    icon: 'pullRequest',
    title: 'See every pull request at a glance',
    text: 'Live CI, review and merge state on each card: failing checks, requested changes, conflicts, ready to merge. Tabs for what you opened, what needs your review and where you are mentioned.',
  },
  {
    icon: 'bell',
    title: 'Know the moment something changes',
    text: 'Choose the events that notify you, set quiet hours, and read the toolbar badge to see how many pull requests need you.',
  },
  {
    icon: 'merge',
    title: 'Act without switching tabs',
    text: 'Approve, request changes, comment, merge or re-run failed checks from the panel. Snooze or mute the noisy ones.',
  },
  {
    icon: 'key',
    title: 'Private by design',
    text: 'Prowl runs in your browser. Your token stays on your device, GitHub is the only server it talks to, there is no telemetry, and it cannot read or change the pages you visit.',
    link: ['Read the privacy policy', 'privacy/'],
  },
] as const;
---

<Base
  title="Prowl: your GitHub pull requests in a Chrome side panel"
  description="Prowl is a free, open source Chrome side panel that follows your GitHub pull requests: live CI, review and merge state, notifications and one-click actions. No backend, no telemetry."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>Your pull requests, at a glance</h1>
        <p class="lead">
          Prowl is a Chrome side panel that follows your GitHub pull requests. See CI, reviews
          and merge state live, get a notification when something changes, and act without
          leaving your tab.
        </p>
        <p class="actions">
          <a class="button" data-variant="primary" href={INSTALL}>Install Prowl</a>
          <a class="button" href={REPO}>View on GitHub</a>
        </p>
        <p class="note">Free and open source. No Prowl account, no backend, no telemetry.</p>
      </div>
      <Screenshot
        light={light}
        dark={dark}
        alt="The Prowl side panel listing pull requests with their CI, review and merge status."
        priority
      />
    </div>
  </section>

  <section class="section" aria-labelledby="features">
    <div class="wrap">
      <h2 id="features" class="section-title">Stay on top of every pull request</h2>
      <ul class="features">
        {
          features.map((feature) => (
            <li>
              <span class="feature-icon">
                <Icon name={feature.icon} />
              </span>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
              {'link' in feature && <a href={page(feature.link[1])}>{feature.link[0]}</a>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="permissions">
    <div class="wrap prose">
      <h2 id="permissions" class="section-title">Prowl cannot read the pages you visit</h2>
      <p class="lead">
        Prowl has no access to your tabs or their content. Chrome enforces that, not a promise:
        an extension can only touch a page if its manifest asks for it, and Prowl's manifest asks
        for the six things below and nothing else. A test fails the build if that list grows.
      </p>
      <table>
        <thead>
          <tr>
            <th scope="col">Permission</th>
            <th scope="col">What it allows</th>
            <th scope="col">Chrome's install prompt</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>sidePanel</code></td>
            <td>Show Prowl in the side panel</td>
            <td>Nothing</td>
          </tr>
          <tr>
            <td><code>storage</code></td>
            <td>Keep your settings and data on your device</td>
            <td>Nothing</td>
          </tr>
          <tr>
            <td><code>alarms</code></td>
            <td>Check GitHub on a schedule</td>
            <td>Nothing</td>
          </tr>
          <tr>
            <td><code>notifications</code></td>
            <td>Tell you when a pull request changes</td>
            <td>"Display notifications"</td>
          </tr>
          <tr>
            <td><code>api.github.com</code></td>
            <td>Read your pull requests and act on them, with your token</td>
            <td>"Read and change your data on api.github.com"</td>
          </tr>
          <tr>
            <td><code>github.com</code> (optional)</td>
            <td>Sign in with GitHub; asked for only then, and given back</td>
            <td>Nothing at install</td>
          </tr>
        </tbody>
      </table>
      <p>
        Prowl can never read, inject code into or change a page, list your tabs or history, see
        other sites' requests or cookies, or be driven by a web page: it has none of the
        permissions for that.
        <a href={page('privacy/#what-prowl-can-never-do')}>See everything it can never do</a>.
      </p>
    </div>
  </section>

  <section class="section band" aria-labelledby="install">
    <div class="wrap">
      <h2 id="install" class="section-title">Install in under five minutes</h2>
      <ol class="steps">
        <li>
          <h3>Download</h3>
          <p>Get the latest zip from the releases page and unzip it into a new folder.</p>
        </li>
        <li>
          <h3>Load it in Chrome</h3>
          <p>
            Open <code>chrome://extensions</code>, turn on Developer mode, choose Load unpacked
            and pick the unzipped folder.
          </p>
        </li>
        <li>
          <h3>Sign in</h3>
          <p>
            Click the Prowl icon to open the side panel, then <a href={page('auth/')}>sign in with GitHub
            or a token</a>.
          </p>
        </li>
      </ol>
      <p class="actions">
        <a class="button" data-variant="primary" href={INSTALL}>Install Prowl</a>
        <a class="button" href={page('install/')}>Read the install guide</a>
      </p>
    </div>
  </section>
</Base>

---
import dark from '../../../docs/screenshots/list-dark.png';
import light from '../../../docs/screenshots/list-light.png';
import logo from '../../../src/assets/logo.png';
import Icon from '../components/Icon.astro';
import Screenshot from '../components/Screenshot.astro';
import Base from '../layouts/Base.astro';
import { page, REPO, STORE } from '../links';

const features = [
  {
    icon: 'pullRequest',
    title: 'See every pull request at a glance',
    text: 'Live CI, review and merge state on each card: failing checks, requested changes, conflicts, ready to merge. A bar at the bottom for what you opened, what needs your review or your teams’ and where you are mentioned. Old, draft and bot PRs step aside until you want them.',
  },
  {
    icon: 'bell',
    title: 'Know the moment something changes',
    text: 'Choose the events that notify you, open or snooze a pull request right from the notification, set quiet hours, and read the toolbar badge to see how many need you.',
  },
  {
    icon: 'merge',
    title: 'Act without switching tabs',
    text: 'Approve, request changes, comment, merge, turn on auto-merge, update a branch that is behind or re-run failed checks from the panel. Ctrl+Shift+P (⌘⇧P on Mac) opens it.',
  },
  {
    icon: 'key',
    title: 'Private by design',
    text: 'Prowl runs in your browser. Your token stays on your device, GitHub is the only server it talks to, there is no telemetry, and it cannot read or change the pages you visit.',
    link: ['Read the privacy policy', 'privacy/'],
  },
] as const;
---

<Base
  title="Prowl — Open source GitHub pull request manager for Chrome"
  description="Prowl is a free, open source Chrome side panel that follows your GitHub pull requests: live CI, review and merge state, notifications and one-click actions. No backend, no telemetry."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <a class="eyebrow" href={`${REPO}/blob/main/LICENSE`}>OPEN SOURCE · MIT LICENSED <span aria-hidden="true">↗</span></a>
        <h1>A quiet eye on<br />your <span>pull requests.</span></h1>
        <p class="lead">
          Your GitHub pull requests, right beside your work. Track CI, catch reviews and
          merge when you’re ready. All from Chrome’s side panel.
        </p>
        <p class="actions">
          <a class="button" data-variant="primary" href={STORE}>Add to Chrome</a>
          <a class="button" href={REPO}>Explore the source <span aria-hidden="true">↗</span></a>
        </p>
        <p class="note">Free. No Prowl account. No tracking. Just you and GitHub.</p>
        <div class="hero-facts" aria-label="Highlights"><span>CI &amp; reviews</span><span>Merge actions</span><span>Local data</span></div>
      </div>
      <div class="hero-preview">
        <p class="preview-label"><span aria-hidden="true">●</span> YOUR PRS. ONE CALM PLACE.</p>
        <Screenshot light={light} dark={dark} alt="The Prowl side panel listing pull requests with their CI, review and merge status." priority />
        <p class="preview-caption">A little less tab hopping. A lot more focus.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="features">
    <div class="wrap">
      <p class="eyebrow">LESS CHECKING. MORE SHIPPING.</p>
      <h2 id="features" class="section-title">Know what needs you.<br />Keep everything else quiet.</h2>
      <ul class="features">
        {
          features.map((feature) => (
            <li>
              <span class="feature-icon">
                <Icon name={feature.icon} />
              </span>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
              {'link' in feature && <a href={page(feature.link[1])}>{feature.link[0]}</a>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="permissions">
    <div class="wrap prose">
      <h2 id="permissions" class="section-title">Prowl cannot read the pages you visit</h2>
      <p class="lead">
        Your token and PR data stay on your device. Prowl talks directly to GitHub, with no
        backend and no telemetry. It has no permission to read your tabs or their content.
      </p>
      <details class="permission-details">
        <summary>See exactly which permissions Prowl uses</summary>
      <table>
        <thead>
          <tr>
            <th scope="col">Permission</th>
            <th scope="col">What it allows</th>
            <th scope="col">Chrome's install prompt</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>sidePanel</code></td>
            <td>Show Prowl in the side panel</td>
            <td>Nothing</td>
          </tr>
          <tr>
            <td><code>storage</code></td>
            <td>Keep your settings and data on your device</td>
            <td>Nothing</td>
          </tr>
          <tr>
            <td><code>alarms</code></td>
            <td>Check GitHub on a schedule</td>
            <td>Nothing</td>
          </tr>
          <tr>
            <td><code>notifications</code></td>
            <td>Tell you when a pull request changes</td>
            <td>"Display notifications"</td>
          </tr>
          <tr>
            <td><code>api.github.com</code></td>
            <td>Read your pull requests and act on them, with your token</td>
            <td>"Read and change your data on api.github.com"</td>
          </tr>
          <tr>
            <td><code>github.com</code> (optional)</td>
            <td>Sign in with GitHub; asked for only then, and given back</td>
            <td>Nothing at install</td>
          </tr>
        </tbody>
      </table>
      </details>
      <p>
        Prowl can never read, inject code into or change a page, list your tabs or history, see
        other sites' requests or cookies, or be driven by a web page: it has none of the
        permissions for that.
        <a href={page('privacy/#what-prowl-can-never-do')}>See everything it can never do</a>.
      </p>
    </div>
  </section>

  <section class="section open-source" aria-labelledby="open-source">
    <div class="wrap open-source-grid">
      <div>
        <p class="eyebrow">BUILT IN THE OPEN</p>
        <h2 id="open-source" class="section-title">Your workflow.<br />Your software.</h2>
        <p class="lead">Read the code. Build it yourself. Make it better for everyone. Prowl is free and open source under the MIT License.</p>
        <p class="actions"><a class="button" data-variant="primary" href={REPO}>Explore GitHub <span aria-hidden="true">↗</span></a><a class="button" href={page('contributing/')}>Make your first contribution</a></p>
        <p class="note"><a href={`${REPO}/blob/main/docs/status.md#roadmap`}>Roadmap</a> · <a href={`${REPO}/issues`}>Ideas &amp; issues</a> · <a href={`${REPO}/blob/main/LICENSE`}>MIT License</a></p>
      </div>
      <div class="mascot-card"><img src={logo.src} alt="Prowl’s watchful cat mascot" width="240" height="240" loading="lazy" /><p>Small companion. Open source.</p></div>
    </div>
  </section>

  <section class="section band" aria-labelledby="install">
    <div class="wrap">
      <h2 id="install" class="section-title">Install in a minute</h2>
      <ol class="steps">
        <li>
          <h3>Add it to Chrome</h3>
          <p>
            Open Prowl in the <a href={STORE}>Chrome Web Store</a> and choose Add to Chrome. It
            updates itself from then on.
          </p>
        </li>
        <li>
          <h3>Pin it</h3>
          <p>Pin Prowl from the puzzle-piece Extensions menu so its icon stays in reach.</p>
        </li>
        <li>
          <h3>Sign in</h3>
          <p>
            Click the Prowl icon to open the side panel, then <a href={page('auth/')}>sign in with GitHub
            or a token</a>.
          </p>
        </li>
      </ol>
      <p class="actions">
        <a class="button" data-variant="primary" href={STORE}>Add to Chrome</a>
        <a class="button" href={page('install/')}>Read the install guide</a>
      </p>
    </div>
  </section>
</Base>

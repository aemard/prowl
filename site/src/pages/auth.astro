---
import { getImage } from 'astro:assets';
import { compiledContent } from '../../../docs/auth.md';
import deviceFlow from '../../../docs/screenshots/device-flow.png';
import onboarding from '../../../docs/screenshots/onboarding.png';
import Base from '../layouts/Base.astro';

// The guide sizes its screenshots with HTML (`<img width="400">`, the only way to size an image
// on GitHub) and Astro does not process local images in HTML: point each at its WebP, the 1x file
// for standard screens and the 2x one for HiDPI.
const screenshots: Record<string, ImageMetadata> = {
  'device-flow.png': deviceFlow,
  'onboarding.png': onboarding,
};
let html = await compiledContent();
for (const [attribute, file] of html.matchAll(/src="\.\/screenshots\/([\w-]+\.png)"/g)) {
  const { src, srcSet } = await getImage({
    src: screenshots[file],
    format: 'webp',
    quality: 90,
    width: 400,
    densities: [1, 2],
  });
  html = html.replace(attribute, `src="${src}" srcset="${srcSet.attribute}"`);
}
---

<Base
  title="Sign in: Prowl"
  description="How to sign in to Prowl with GitHub or a personal access token: classic or fine-grained, the exact scopes and permissions, and what to do when something goes wrong."
>
  <article class="section wrap prose">
    <Fragment set:html={html} />
  </article>
</Base>

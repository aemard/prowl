---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  /** Shown instead of `light` when the visitor prefers a dark color scheme. */
  dark?: ImageMetadata;
  alt: string;
  /** Above the fold: load at once and at high priority. */
  priority?: boolean;
}

const { light, dark, alt, priority = false } = Astro.props;
// The real side panel screenshots, converted to WebP at build time.
const convert = (src: ImageMetadata) => getImage({ src, format: 'webp', quality: 90 });
const [lightImage, darkImage] = await Promise.all([convert(light), dark && convert(dark)]);
---

<picture class="shot">
  {darkImage && <source media="(prefers-color-scheme: dark)" srcset={darkImage.src} />}
  <img
    src={lightImage.src}
    width={lightImage.attributes.width}
    height={lightImage.attributes.height}
    alt={alt}
    loading={priority ? undefined : 'lazy'}
    decoding={priority ? undefined : 'async'}
    fetchpriority={priority ? 'high' : undefined}
  />
</picture>

---
import social from '../../../docs/store/promo-social.png';
import logo from '../../../src/assets/logo.png';
import '../../../src/styles/tokens.css';
import '../styles/site.css';
import '../styles/sections.css';
import '../styles/landing.css';
import { page, REPO } from '../links';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  ['Install', 'install/'],
  ['Sign in', 'auth/'],
  ['Changelog', 'changelog/'],
  ['Contribute', 'contributing/'],
] as const;
const current = (path: string) => (Astro.url.pathname === page(path) ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- The site ships no script, and Markdown pages (the changelog, the guides) may hold raw HTML:
         nothing may run, load from elsewhere or post a form. Styles are inlined at build time;
         connect-src lets crawlers' in-page checks (Lighthouse reads robots.txt) reach this origin. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; script-src 'none'; base-uri 'none'; form-action 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={logo.src} type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prowl" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(social.src, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Prowl, the open source GitHub pull request manager for Chrome, with its cat logo and side panel." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={page()}>
          <img src={logo.src} alt="" width="32" height="32" />
          Prowl
        </a>
        <nav aria-label="Main">
          {
            nav.map(([label, path]) => (
              <a href={page(path)} aria-current={current(path)}>{label}</a>
            ))
          }
          <a href={REPO}>GitHub</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap bar">
        <p>Open source under the MIT License. Not affiliated with GitHub.</p>
        <nav aria-label="Footer">
          <a href={page('privacy/')} aria-current={current('privacy/')}>Privacy</a>
          <a href={`${REPO}/issues`}>Issues</a>
          <a href={REPO}>GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

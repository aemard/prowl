{
  "name": "prowl",
  "version": "1.0.0",
  "private": true,
  "description": "Minimalist Chrome side panel to follow your GitHub pull requests at a glance.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "zip": "node scripts/zip.mjs",
    "size": "node scripts/check-size.mjs",
    "icons": "node scripts/icons.mjs",
    "store-images": "node scripts/store-images.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "pnpm build:e2e && playwright test",
    "screenshots": "PROWL_SCREENSHOTS=1 pnpm e2e",
    "verify:fast": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm lint && pnpm typecheck && pnpm coverage && pnpm build && pnpm --filter site build && pnpm size && pnpm e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8"
  }
}

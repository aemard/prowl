{
  "name": "prowl",
  "version": "1.4.0",
  "private": true,
  "description": "Open source Chrome extension to manage GitHub pull requests: CI, reviews and merge actions in your side panel.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "zip": "node scripts/zip.mjs",
    "size": "node scripts/check-size.mjs",
    "icons": "node scripts/icons.mjs",
    "store-images": "node scripts/store-images.mjs",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "pnpm build && pnpm build:e2e && playwright test",
    "screenshots": "PROWL_SCREENSHOTS=1 pnpm e2e",
    "verify:fast": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:changed": "pnpm verify:fast && pnpm build && pnpm size",
    "verify": "pnpm lint && pnpm typecheck && pnpm coverage && pnpm build && pnpm --filter site build && pnpm size && pnpm e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8"
  }
}
